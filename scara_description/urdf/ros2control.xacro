<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="scara">

    <xacro:property name="PI" value="3.14159265359"/>

    <xacro:arg name="is_sim"      default="true"/>
    <xacro:arg name="is_ignition" default="false"/>

    <!-- Real robot: an Arduino driving stepper drivers over USB serial.
         Only looked at when is_sim is false. -->
    <xacro:arg name="is_real"     default="false"/>
    <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
    <xacro:arg name="wait_for_done" default="false"/>

    <ros2_control name="RobotSystem" type="system">

        <!-- ══ Which hardware actually moves? ═══════════════════════════════
             is_sim=True                → Gazebo physics
             is_sim=False, is_real=True → the real arm, via scara_firmware
             is_sim=False, is_real=False→ mock_components (RViz only, no robot)
             Everything below this block is identical in all three cases, which
             is what lets one MoveIt/RViz setup drive all of them. -->

        <xacro:if value="$(arg is_sim)">
            <xacro:if value="$(arg is_ignition)">
                <!-- Ignition Fortress (ROS 2 Humble) -->
                <hardware>
                    <plugin>ign_ros2_control/IgnitionSystem</plugin>
                </hardware>
            </xacro:if>
            <xacro:unless value="$(arg is_ignition)">
                <!-- Gazebo Garden/Harmonic (ROS 2 Iron+) -->
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:unless>
        </xacro:if>

        <xacro:unless value="$(arg is_sim)">

            <!-- REAL ROBOT — open loop, no encoders.  Position commands are
                 serialised and streamed to the Arduino; the reported state is
                 simply the last command. -->
            <xacro:if value="$(arg is_real)">
                <hardware>
                    <plugin>scara_firmware/ScaraHardwareInterface</plugin>
                    <param name="port">$(arg serial_port)</param>
                    <!-- false = stream setpoints continuously (smooth motion)
                         true  = wait for the Arduino's DONE after every setpoint,
                                 which stops the motors at each one and jerks -->
                    <param name="wait_for_done">$(arg wait_for_done)</param>
                </hardware>
            </xacro:if>

            <!-- Standalone / slider GUI — no Gazebo, no hardware -->
            <xacro:unless value="$(arg is_real)">
                <hardware>
                    <plugin>mock_components/GenericSystem</plugin>
                </hardware>
            </xacro:unless>

        </xacro:unless>

        <!-- Base Rotation -->
        <joint name="column_joint">
            <command_interface name="position">
                <param name="min">-2.0</param>
                <param name="max">2.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Vertical Slide -->
        <joint name="shoulder_joint">
            <command_interface name="position">
                <param name="min">-0.15</param>
                <param name="max">0.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Forearm Rotation -->
        <joint name="forearm_joint">
            <command_interface name="position">
                <param name="min">-2.0</param>
                <param name="max">2.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Wrist Rotation -->
        <joint name="wrist_joint">
            <command_interface name="position">
                <param name="min">-4.712</param>
                <param name="max">4.712</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Master Gripper — command interface here -->
        <joint name="left_finger_joint">
            <command_interface name="position">
                <param name="min">-0.06</param>
                <param name="max">0.0</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Mimic Joint — state only, no command interface -->
        <joint name="right_finger_joint">
            <param name="mimic">left_finger_joint</param>
            <param name="multiplier">1.0</param>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>

</robot>
